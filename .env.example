# Mock needs no configuration. Environment variables are not loaded from .env automatically.
AGENT_BACKEND=mock
# Required only for --backend api. Use your own provider and credentials.
AGENT_MODEL=
AGENT_API_BASE=https://api.openai.com/v1
AGENT_API_KEY=
# Optional executable name/path, never an authentication file.
AGENT_CODEX_BIN=codex
